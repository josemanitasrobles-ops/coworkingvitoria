{
  "name": "Reserva",
  "type": "object",
  "properties": {
    "espacio_id": {
      "type": "string"
    },
    "espacio_nombre": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la reserva en formato YYYY-MM-DD"
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hora de inicio HH:MM"
    },
    "hora_fin": {
      "type": "string",
      "description": "Hora de fin HH:MM"
    },
    "nombre": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "prerreservada",
        "reservada",
        "cancelada"
      ],
      "enumColors": [
        "yellow",
        "red",
        "gray"
      ],
      "default": "prerreservada"
    },
    "precio_total": {
      "type": "number"
    },
    "origen": {
      "type": "string",
      "enum": [
        "web",
        "manual",
        "bloqueo"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "web"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "espacio_id",
    "fecha",
    "hora_inicio",
    "hora_fin",
    "nombre"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}